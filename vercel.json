{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/school",
      "destination": "/school/index.html"
    },
    {
      "source": "/school/admin",
      "destination": "/school/admin.html"
    },
    {
      "source": "/school/:path*",
      "destination": "/school/:path*"
    },
    {
      "source": "/operation-paga",
      "destination": "/operation-paga/index.html"
    },
    {
      "source": "/operation-paga/:path*",
      "destination": "/operation-paga/:path*"
    },
    {
      "source": "/student-prayers",
      "destination": "/student-prayers/index.html"
    },
    {
      "source": "/student-prayers/:path*",
      "destination": "/student-prayers/:path*"
    },
    {
      "source": "/control-panel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/control-panel",
      "destination": "/index.html"
    },
    {
      "source": "/control-panel/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
