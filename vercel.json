{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api",
      "dest": "/api/index.js"
    },
    {
      "src": "/school",
      "dest": "/school/index.html"
    },
    {
      "src": "/school/admin",
      "dest": "/school/admin.html"
    },
    {
      "src": "/school/(.*)",
      "dest": "/school/$1"
    },
    {
      "src": "/operation-paga",
      "dest": "/operation-paga/index.html"
    },
    {
      "src": "/operation-paga/(.*)",
      "dest": "/operation-paga/$1"
    },
    {
      "src": "/student-prayers",
      "dest": "/student-prayers/index.html"
    },
    {
      "src": "/student-prayers/(.*)",
      "dest": "/student-prayers/$1"
    },
    {
      "src": "/control-panel/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/control-panel",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
