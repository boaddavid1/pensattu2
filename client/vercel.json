{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pensa-ttu-api.onrender.com/api/:path*"
    },
    {
      "source": "/control-panel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/control-panel",
      "destination": "/index.html"
    },
    {
      "source": "/control-panel/",
      "destination": "/index.html"
    },
    {
      "source": "/school",
      "destination": "/school/index.html"
    },
    {
      "source": "/school/admin",
      "destination": "/school/admin.html"
    },
    {
      "source": "/school/:path*",
      "destination": "/school/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
