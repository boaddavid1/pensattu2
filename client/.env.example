# Backend API URL used by the client
# Include the /api path suffix, e.g. https://your-backend.vercel.app/api
VITE_API_URL=http://localhost:3001/api

# Cloudinary image upload config (used by the admin image uploader)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# VAPID public key for push notifications (optional)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
